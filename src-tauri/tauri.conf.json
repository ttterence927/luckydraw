{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hitachi Rail Lucky Draw",
  "version": "0.1.0",
  "identifier": "com.hitachirail.luckydraw",
  "build": {
    "frontendDist": "http://localhost:3977",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/tauri-prepare.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hitachi Rail Lucky Draw",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "url": "data:text/html,<html><body style='background:%231a1a2e;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;font-family:sans-serif'><div style='color:white;text-align:center'><p style='font-size:1.5rem;margin:0 0 8px;font-weight:600'>Hitachi Rail Lucky Draw</p><p style='color:%23aaaaaa;margin:0;font-size:.95rem'>Starting&hellip;</p></div></body></html>"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "windows": {

    }
  }
}
